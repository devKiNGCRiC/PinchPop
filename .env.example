# The site's public URL, no trailing slash. Used for canonical links and Open Graph/Twitter
# preview tags (src/lib/seo.ts). Set this once the app has a real domain — Cloudflare Pages gives
# a free one like https://pinchpop.pages.dev, or use your own if you attach one later.
VITE_SITE_URL=https://pinchpop.pages.dev

# Supabase project settings → API Keys → "Publishable and secret API keys" tab. The publishable
# key is safe to expose (it's embedded in the client bundle, like the legacy anon key it
# replaces); access control is enforced by Row Level Security policies on each table, not by
# keeping this key secret. Never put the secret key or DB password in a VITE_-prefixed variable
# — anything with that prefix ships to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
